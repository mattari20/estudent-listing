{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estudent.pk/schemas/phase1c-readonly-diagnostic-v1.json",
  "title": "Phase 1C Read-only Diagnostic Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","database","tables","columns","indexes","expected_index_reconciliation","foreign_keys","queue_mapping","alert_mapping","orphan_checks","duplicate_checks","registry_counts","transaction"],
  "properties": {
    "schema_version": {"const": "phase1c-readonly-diagnostic/v1"},
    "database": {"type":"object","required":["engine","server_version"],"properties":{"engine":{"enum":["mysql","mariadb"]},"server_version":{"type":"string","maxLength":128}},"additionalProperties":false},
    "tables": {"type":"array","minItems":39,"maxItems":39,"items":{"type":"object","required":["table","state"],"properties":{"table":{"type":"string"},"state":{"enum":["PASS","MISSING","UNKNOWN"]},"options":{"type":"object"},"create_table_sql":{"type":"string"},"error":{"type":"object","required":["exception_class","sqlstate","vendor_code"]}},"additionalProperties":true}},
    "columns": {"type":"array","items":{"type":"object","required":["table"],"properties":{"table":{"type":"string"},"COLUMN_NAME":{"type":"string"},"ORDINAL_POSITION":{"type":["integer","string"]},"COLUMN_DEFAULT":{},"IS_NULLABLE":{"type":"string"},"DATA_TYPE":{"type":"string"},"COLUMN_TYPE":{"type":"string"},"EXTRA":{"type":"string"},"GENERATION_EXPRESSION":{"type":"string"},"state":{"enum":["UNKNOWN"]},"error":{"type":"object"}},"additionalProperties":true}},
    "indexes": {"type":"array","items":{"type":"object","required":["table"],"properties":{"table":{"type":"string"},"INDEX_NAME":{"type":"string"},"NON_UNIQUE":{"type":["integer","string"]},"SEQ_IN_INDEX":{"type":["integer","string"]},"COLUMN_NAME":{"type":["string","null"]},"SUB_PART":{"type":["integer","string","null"]},"INDEX_TYPE":{"type":"string"},"state":{"enum":["UNKNOWN"]},"error":{"type":"object"}},"additionalProperties":true}},
    "expected_index_reconciliation": {"type":"array","minItems":23,"maxItems":23,"items":{"type":"object","required":["table","name","columns","unique","index_type","state"],"properties":{"table":{"type":"string"},"name":{"type":"string"},"columns":{"type":"array","items":{"type":"string"}},"unique":{"type":"boolean"},"index_type":{"type":"string"},"state":{"enum":["PASS","FAIL","MISSING","NOT_CHECKED"]},"reason":{"type":"string"},"observed":{"type":"object"}},"additionalProperties":true}},
    "foreign_keys": {"type":"array","items":{"type":"object"}},
    "queue_mapping": {"type":"object","required":["state","records"],"properties":{"state":{"enum":["PASS","FAIL","NOT_CHECKED","UNKNOWN"]},"open_record_count":{"type":"integer","minimum":0},"reason":{"type":"string"},"records":{"type":"array","maxItems":5,"items":{"type":"object","required":["record_ordinal","state"],"properties":{"record_ordinal":{"type":"integer","minimum":1,"maximum":5},"state":{"enum":["PASS","FAIL","NOT_CHECKED","UNKNOWN"]},"mapping_match_count":{"type":"integer","minimum":0}},"additionalProperties":false}}},"additionalProperties":true},
    "alert_mapping": {"type":"object","required":["state","records"],"properties":{"state":{"enum":["PASS","FAIL","NOT_CHECKED","UNKNOWN"]},"open_record_count":{"type":"integer","minimum":0},"reason":{"type":"string"},"records":{"type":"array","maxItems":2,"items":{"type":"object","required":["record_ordinal","state"],"properties":{"record_ordinal":{"type":"integer","minimum":1,"maximum":2},"state":{"enum":["PASS","FAIL","NOT_CHECKED","UNKNOWN"]},"mapping_match_count":{"type":"integer","minimum":0}},"additionalProperties":false}}},"additionalProperties":true},
    "orphan_checks": {"type":"array","minItems":18,"maxItems":18,"items":{"type":"object","required":["id","state"],"properties":{"id":{"type":"string"},"state":{"enum":["PASS","FAIL","NOT_CHECKED","UNKNOWN"]},"orphan_exists":{"type":"boolean"},"missing_prerequisites":{"type":"array","items":{"type":"string"}},"error":{"type":"object"}},"additionalProperties":true}},
    "duplicate_checks": {"type":"array","minItems":14,"maxItems":14,"items":{"type":"object","required":["id","state"],"properties":{"id":{"type":"string"},"state":{"enum":["PASS","FAIL","NOT_CHECKED","UNKNOWN"]},"duplicate_group_exists":{"type":"boolean"},"missing_prerequisites":{"type":"array","items":{"type":"string"}},"error":{"type":"object"}},"additionalProperties":true}},
    "registry_counts": {"type":"object","required":["tables","expected_indexes","orphan_checks","duplicate_checks"],"properties":{"tables":{"const":39},"expected_indexes":{"const":23},"orphan_checks":{"const":18},"duplicate_checks":{"const":14}},"additionalProperties":false},
    "transaction": {"type":"object","required":["mode","outcome"],"properties":{"mode":{"const":"READ ONLY"},"outcome":{"const":"ROLLED_BACK"}},"additionalProperties":false}
  }
}