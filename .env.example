APP_NAME="eStudent Institutes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/institutes
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estudent_institutes
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Optional provider-backed AI extraction for the institute discovery agent.
INSTITUTE_AI_ENABLED=false
INSTITUTE_AI_PROVIDER=openai_compatible
INSTITUTE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
INSTITUTE_AI_API_KEY=
INSTITUTE_AI_MODEL=gpt-5.6-luna
INSTITUTE_AI_TIMEOUT=45
INSTITUTE_AI_MAX_SOURCE_CHARS=120000
INSTITUTE_AI_FALLBACK_DETERMINISTIC=false
